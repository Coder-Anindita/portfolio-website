# Copy this file to .env and fill in the values.
# Get them from https://dashboard.emailjs.com (Email Services, Email Templates, Account → Public Key).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Public URL of the deployed site (used for canonical / Open Graph URLs).
VITE_SITE_URL=http://localhost:5173

# Blog views & likes (used by the /api functions, not exposed to the browser).
# Create a free Upstash Redis database (Vercel → Storage → Upstash, or https://console.upstash.com)
# and copy its REST URL and token. Vercel's integration also works with KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: any random string, used to hash visitor IPs.
STATS_SALT=
